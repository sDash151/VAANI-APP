# ===========================================
# CUSTOM PROJECT SPECIFIC
# ===========================================
# Large documentation files (keep only essential ones)
# Uncomment if you want to exclude large docs
# *.md
# !README.md
# !INTEGRATION_README.md

# Backup files
*.bak
*.backup
*.old

# Archive files
*.zip
*.tar.gz
*.rar
*.7z

# ===========================================
# KEEP ESSENTIAL FILES
# ===========================================
# Keep ALL your project documentation files (exclude dependency .md files)
!README.md
!INTEGRATION_README.md
!REALME_7_SETUP_GUIDE.md
!ML_INTEGRATION_README.md
!VIDEO_COMPONENTS_README.md
!BSWL_*.md
!VAANI_*.md

# Add specific .md files to ensure they're tracked
!BSWL_ACTIVITY_DIAGRAM.md
!BSWL_COLLABORATION_DIAGRAM.md
!BSWL_DATABASE_DESIGN.md
!BSWL_SEQUENCE_DIAGRAM.md
!BSWL_USE_CASE_DIAGRAM.md
!VAANI_BSWL_LITERATURE_SURVEY.md
!VAANI_BSWL_SOFTWARE_REQUIREMENT_SPECIFICATION.md
!bswl_frontend_app/ML_INTEGRATION_README.md
!bswl_frontend_app/VIDEO_COMPONENTS_README.md

# Exclude dependency .md files from node_modules
node_modules/**/*.md
BSWL_BACKEND/node_modules/**/*.md
bswl_frontend_app/node_modules/**/*.md

# Keep configuration files for better project understanding
!docker-compose.yml
!Dockerfile
!package.json
!pubspec.yaml
!requirements.txt
!pubspec.lock
!package-lock.json

